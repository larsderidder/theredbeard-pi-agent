{
  "name": "theredbeard-pi-agent",
  "version": "0.1.0",
  "description": "theredbeard's pi coding agent extensions, skills, and themes",
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "scripts": {
    "test": "npm run typecheck && npm run test:lazy-tools && npm run test:file-mutations && npm run test:move-session && npm run test:projects",
    "test:file-mutations": "node scripts/test-file-mutations.mjs",
    "test:move-session": "node scripts/test-move-session.mjs",
    "test:lazy-tools": "node scripts/test-lazy-tools.mjs",
    "test:projects": "node scripts/test-projects.mjs",
    "test:search-security": "node scripts/test-search-security.mjs",
    "test:search-security:live": "node scripts/test-search-security.mjs --live",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "puppeteer": "^25.8.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^22.19.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  }
}
